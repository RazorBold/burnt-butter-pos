# Salin ke .env.local lalu isi. Jangan commit .env.local.
# Nilai diambil dari Supabase Dashboard > Project Settings (region Singapore).

# Aplikasi: pooler mode transaction (port 6543)
DATABASE_URL=
# drizzle-kit migrate & seed: koneksi session/direct (port 5432)
DIRECT_DATABASE_URL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server saja (membuat user dari Master Data). Jangan pernah dipakai di client.
SUPABASE_SECRET_KEY=

# Melindungi /api/cron/keep-alive (Vercel mengirimnya otomatis sebagai Bearer token)
CRON_SECRET=
