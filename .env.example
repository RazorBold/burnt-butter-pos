# Env diisi otomatis oleh integrasi Supabase di Vercel.
# Lokal: jalankan `vercel env pull .env.local` (project sudah di-link). Jangan commit .env.local.

# Aplikasi: pooler mode transaction (port 6543)
POSTGRES_URL=
# drizzle-kit migrate & seed: koneksi session (port 5432)
POSTGRES_URL_NON_POOLING=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server saja (membuat user dari Master Data). Jangan pernah dipakai di client.
SUPABASE_SECRET_KEY=

# Hanya di Production (Vercel mengirimnya otomatis sebagai Bearer token ke /api/cron/keep-alive)
CRON_SECRET=

# Lokal: isi DATABASE_URL dengan nilai POSTGRES_URL_NON_POOLING (pooler mode session).
# Di Vercel biarkan kosong, aplikasi memakai POSTGRES_URL (mode transaction). Alasannya di
# docs/ARCHITECTURE.md.
# DATABASE_URL=
# Opsional: menimpa POSTGRES_URL_NON_POOLING untuk migrasi, seed, dan skrip.
# DIRECT_DATABASE_URL=
